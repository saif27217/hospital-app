{
  "expo": {
    "name": "hospital-app",
    "slug": "hospital-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hospitalapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hyd.hospitalapp",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070D1A",
          "image": null,
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "displayName": "Hyd Hospitals",
    "splash": {
      "image": null,
      "resizeContent": null
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dc937e8b-1591-4e8d-8388-78199cfb0767"
      }
    },
    "owner": "drsaifbiochems-team",
    "updates": {
      "url": "https://u.expo.dev/dc937e8b-1591-4e8d-8388-78199cfb0767"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
